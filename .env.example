# Connection string of the Postgres database.
DATABASE_URL=postgresql://user:password@host/database

# Secret used to sign session cookies. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# First administrator, created on the first start if it does not exist yet.
# Leave ADMIN_PASSWORD empty to have one generated and printed to the log once.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

PORT=3000
NODE_ENV=production

# Set to "disable" only for a local Postgres without TLS.
# PGSSLMODE=disable
